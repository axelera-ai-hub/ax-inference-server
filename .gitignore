.no_git_*
.sdk/**
.runner/**
client/assets/**

# Exception: the S3-link pointer for the Iso-VLM/LLM-Demo sample video --
# the .link file itself is a small retrieval script meant to be tracked,
# unlike the large binary test assets ignored above by client/assets/**.
# A trailing "/**" excludes the whole subtree from being walked at all, so
# un-ignoring a single file inside it needs the directory re-opened first,
# its other contents re-excluded, then the one file re-included.
!client/assets/test_images/
client/assets/test_images/*
!client/assets/test_images/39837-424360872_tiny.mp4.link
**/.trash/**
**/__pycache__/**
graphify-out/**

# grpc_tools.protoc / CMake-codegen output -- every "generated/" dir in this
# repo (server/tests/smoke/, server/tests/perf/, server/src/interface/,
# server/build*/) is regenerated fresh by a runner file's own stub-generation
# step or the CMake build itself; none are ever meant to be committed. One
# rule instead of enumerating each new "generated/" dir as it's added.
**/generated/**

# CMake/Ninja build output -- regenerated by .runner/03_server_minimal_bringup_v0.yaml
server/build/**
server/build*/**

# YAMNet: build/ is fully regenerable (cpp_preprocess .so, calibration images,
# compiled model); ESC-50-master/ is real data fetched via ESC-50-master.link
# (S3) or a git-clone fallback -- see .runner/02_port_yamnet_v0.yaml. Neither
# is meant to be committed.
server/models/yamnet/build/**
server/models/yamnet/ESC-50-master/**

# Never ship a prebuilt cpp_preprocess binary -- always built fresh from source.
**/cpp_preprocess/*.so

# SmolVLM2 / Qwen3-0.6B / Qwen3-4B / Qwen3-8B / Llama-3.2-1B / Llama-3.1-8B:
# real weight data fetched via the sibling .link scripts (S3) -- see
# server/models/*.link. Never meant to be committed (matches
# inference_server-vllm-serving's convention).
server/models/qwen3-0.6b/**
server/models/smolvlm2-256m-video-instruct/**
server/models/qwen3_4b/**
server/models/qwen3_8b/**
server/models/llama3_1_8b/**
server/models/llama3_2_1b/**

# Patched axelera_runtime wheels: fetched via the sibling .link script (S3),
# see server/patches/patched_wheels/*.link and
# the deploy runner's vLLM memleak-fix validation. The .link
# file is the artifact; the wheel itself is never meant to be committed.
server/patches/patched_wheels/*.whl

# Legacy onnxruntime tarball for SDK v1.9.0 builds, whose Makefile downloaded
# it from an upstream URL that now returns 404. SDK v1.9.1 fetches onnxruntime
# from a working source, so the tarball is no longer used by setup.sh; any local
# copy is a leftover and is never meant to be committed.
server/patches/onnxruntime/

# Unused/retired model directories moved aside for later cleanup -- not
# source, never meant to be committed.
server/models/.bkp/

# Vendored roboflow/trackers + roboflow/supervision source clones (client-side
# tracking only, not part of the inference server itself) -- installed
# editable into the GUI's own venv, see client/setup.sh's --tracker flag.
client/tracker/roboflow/**

# Many-device configs auto-generated by a device-list generator -- generated
# artifact, not source, and host-specific (bakes in that host's own
# confirmed-healthy device list + NUMA-local core pinning), never meant to be
# hand-edited or committed.
client/configs/config_*_devlist*.yaml

# Real functional device-health check results (axdownloadmodel+axrunmodel
# smoke test per device), generated on the target host itself
# by its deploy scripts -- host-specific, never committed. Found the hard way
# (2026-09-10): this file was NOT covered by any exclude pattern, so the
# repo-sync step's own `rsync --delete` (nothing excluded from consideration
# survives when it doesn't exist in the local source tree) silently wiped it,
# breaking a later diagnostic step that depended on it still being there from
# an earlier, separate deploy run.
.healthy_devices*.txt

# Vendored, pinned NiceGUI source clone (cloned rather than pip-installed
# because this project intends to extend it) + the GUI app's own venv and
# the npm-installed/Rollup-built Vue Flow bundle -- see
# .runner/60_local_no_code_gui_ui_bringup_v0.yaml.
client/ui/nice-gui/
client/ui/gui/.venv/**
client/ui/gui/components/node_modules/**
client/ui/gui/components/dist/**
client/ui/gui/.smoke_app.log
client/ui/gui/.smoke_app_layoutA.log

# Legacy log from the superseded client/tests/mcp_agents/.claude/hooks/
# log_hook_event.py (replaced by fsm_hooks.py) -- kept locally for analysis,
# never meant to be committed.
client/tests/mcp_agents/mcp_tool_calls.log

# agent-knowledge/ has its own .gitignore: only RUNBOOK.md (the distilled
# cross-run FSM playbook) is tracked, everything else there is per-execution
# runtime state written by .claude/hooks/fsm_hooks.py or a retired
# predecessor of it.

# tldraw design-canvas scaffold (Vite app + file-bridge dev server) and its
# canvas.json content, generated/edited by the tldraw-canvas skill -- never
# meant to be committed.
client/ui/gui/.tldraw-canvas/

# Screenshots dropped by tests/test_click_to_add.py on each run -- debugging
# output, not test code.
client/ui/gui/tests/_*.png

# Debug-mode session recordings (toggle in the app header), replayed via
# tests/replay_recording.py -- per-session captures, not source.
client/ui/gui/debug_recordings/

# Config YAMLs written by "Generate Config YAML" -- generated output, not source.
client/ui/gui/generated_configs/

# Pipeline specs compiled in-process by "Compile Pipeline" (via
# client/compiler/pipeline.py's PipelineCompiler / compiler/vlm.py's
# VlmPipelineCompiler, called directly from client/ui/gui/app.py) before
# their content is sent to deployment/host_server.py's /api/v1/pipeline-spec
# -- generated output, not source, same as generated_configs/ above.
client/ui/gui/compiled_specs/

# Per-source rendered-frame ring buffers written by the Benchmarking tab's
# exact-match renderer (see _apply_infer_result/_benchmark_capture_tick) and
# served back out over /benchmark/thumbnail and /benchmark/stream --
# generated output, not source, same as generated_configs/ above.
client/ui/gui/benchmark_frames/

# deployment/.env holds a real DEPLOYMENT_API_KEY (shared secret between
# host_server.py and the no-code GUI's HOST_SERVER_API_KEY) -- host-specific,
# never committed. Excluding it also protects it from the same rsync --delete
# wipe described above for .healthy_devices*.txt: .env isn't in the local
# source tree either, so without this entry every redeploy would
# silently delete the live key and break /api/v1/models /api/v1/devices auth.
deployment/.env
deployment/venv/**
deployment/uploaded_yaml/**
