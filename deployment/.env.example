# Copy this file to .env and fill in real values. .env must never be committed.

# Required: clients must send this value in the X-API-Key header.
DEPLOYMENT_API_KEY=changeme-generate-a-real-random-token

# Bind address for uvicorn.
BIND_HOST=0.0.0.0
BIND_PORT=8088

# Path to setup.sh (defaults to the copy next to host_server.py).
SETUP_SCRIPT_PATH=/home/ubuntu/spap_v0/inference_server-no-code-gui/deployment/setup.sh

# Directory where uploaded pipeline YAMLs are saved.
YAML_UPLOAD_DIR=/home/ubuntu/spap_v0/inference_server-no-code-gui/deployment/uploaded_yaml

# Required by /api/v1/models and /api/v1/devices: must match the SDK_ROOT
# this host's no-code GUI (client/ui/gui/app.py) is launched with -- see
# the deploy runner's GUI-launch step.
SDK_ROOT=/home/ubuntu/workdir/inference_server-no-code-gui/.sdk/voyager-sdk
# Only needed if the SDK's venv directory isn't named "venv".
#SDK_VENV=venv

# Comma-separated list of allowed path prefixes for --sdk-dest-dir; requests
# with sdk_dest_dir outside these prefixes are rejected.
ALLOWED_SDK_DEST_PREFIXES=/opt/sdk
